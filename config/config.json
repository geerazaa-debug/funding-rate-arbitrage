{
  "pairs": ["BTCUSDT", "ETHUSDT"],
  "exchanges": {
    "bybit": {
      "websocket_url": "wss://stream.bybit.com/v5/public/linear",
      "rest_url": "https://api.bybit.com"
    },
    "binance": {
      "websocket_url": "wss://fstream.binance.com/ws",
      "rest_url": "https://fapi.binance.com"
    }
  },
  "risk": {
    "max_leverage": 2.0,
    "max_daily_loss": 1000,
    "max_exposure_usd": 10000,
    "circuit_breaker_enabled": true
  },
  "monitoring": {
    "metrics_report_interval_s": 30,
    "alert_stale_data_threshold_s": 30,
    "alert_large_differential_threshold": 0.001
  },
  "backfill": {
    "enabled": true,
    "limit": 100,
    "delay_s": 5
  },
  "collection": {
    "db_path": "data/observations.db",
    "sample_interval_s": 10,
    "tradeable_threshold": 0.0005
  }
}
