*.pyc
__pycache__/
.venv/
venv/
*.log
*.db
logs/

# Secrets only. A blanket *.json rule previously excluded config/config.json
# too, so a fresh clone had no configuration at all.
config/secrets.json
config/api_keys.json
*secrets*.json
*credentials*.json
.env
.env.*
!.env.example

# Ad-hoc debugging scripts. These get written quickly, often with credentials
# pasted inline, and are exactly the files that leak keys into history.
# scripts/preflight.py is deliberately NOT here: it reads everything from .env
# and is meant to be tracked and shared.
#
# _*.py also matched __init__.py (leading double-underscore), which silently
# excluded every NEW package's __init__.py from git - discovered when
# src/analysis/__init__.py needed `git add -f` to be tracked at all. The
# negation below only restores dunder files; single-underscore scratch names
# (_scratch.py, _debug.py) are still ignored.
check_live_api.py
scratch_*.py
_*.py
!__*.py
.idea/
.vscode/
*.egg-info/
dist/
build/
