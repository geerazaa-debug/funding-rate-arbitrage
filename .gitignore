*.pyc
__pycache__/
.venv/
venv/
*.log
*.db
logs/

# Secrets only. A blanket *.json rule previously excluded config/config.json
# too, so a fresh clone had no configuration at all.
config/secrets.json
config/api_keys.json
*secrets*.json
*credentials*.json
.env
.env.*
!.env.example

# Ad-hoc debugging scripts. These get written quickly, often with credentials
# pasted inline, and are exactly the files that leak keys into history.
# scripts/preflight.py is deliberately NOT here: it reads everything from .env
# and is meant to be tracked and shared.
check_live_api.py
scratch_*.py
_*.py
.idea/
.vscode/
*.egg-info/
dist/
build/
